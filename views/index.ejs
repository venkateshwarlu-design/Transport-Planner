<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Plan a simple journey and compare sample bus, train, cab, and auto options.">
  <title>Transport Planner | Plan a better journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Transport Planner home">
      <span class="brand-mark" aria-hidden="true">TP</span>
      <span>Transport Planner</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/" aria-current="page">Home</a>
      <a href="/planner">Journey planner</a>
      <a href="/about">About</a>
    </nav>
    <a class="header-action" href="/planner">Plan a trip <span aria-hidden="true">↗</span></a>
  </header>

  <main>
    <section class="home-hero">
      <img class="hero-image" src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=2000&q=85" alt="A modern coach travelling along a tree-lined road">
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow eyebrow-light"><span></span> YOUR NEXT JOURNEY, SORTED</p>
        <h1>Transport<br>Planner</h1>
        <p class="hero-copy">A simpler way to figure out how to get there. Enter your route and explore a few helpful travel options.</p>
        <a class="button button-primary" href="/planner">Plan Your Journey <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-caption"><span class="caption-dot"></span> One route. Four ways to go.</p>
    </section>

    <section class="home-strip" aria-label="Available transport types">
      <div class="strip-intro">
        <p class="eyebrow">PICK YOUR PACE</p>
        <h2>Getting there,<br>your way.</h2>
      </div>
      <div class="mode-list">
        <div class="mode-item"><span class="mode-number">01</span><span class="mode-name">Bus</span><span class="mode-note">Easy on the wallet</span></div>
        <div class="mode-item"><span class="mode-number">02</span><span class="mode-name">Train</span><span class="mode-note">Skip the road traffic</span></div>
        <div class="mode-item"><span class="mode-number">03</span><span class="mode-name">Cab</span><span class="mode-note">Door to door</span></div>
        <div class="mode-item"><span class="mode-number">04</span><span class="mode-name">Auto</span><span class="mode-note">A handy local ride</span></div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand brand-footer" href="/"><span class="brand-mark" aria-hidden="true">TP</span><span>Transport Planner</span></a>
    <span class="footer-note">A student project with sample estimates.</span>
    <span class="footer-copy">© <span data-current-year></span> Transport Planner</span>
  </footer>
  <script src="/js/script.js" defer></script>
</body>
</html>
